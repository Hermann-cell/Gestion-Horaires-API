// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int     @id @default(autoincrement())
  nom          String?
  prenom       String
  email        String  @unique
  mot_de_passe String // Note: In a production application, consider hashing passwords for security.
  statut       Boolean @default(false)
  roleId       Int     @map("role_id")
  role         Role    @relation(fields: [roleId], references: [id])

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("User")
}

model Professeur {
  id        Int     @id @default(autoincrement())
  nom       String?
  prenom    String
  matricule String @unique

  seances Seance[]

  specialite_professeurs Specialite_Professeur[]

  // disponibilite_professeurs Disponibilite_Professeur[]

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("Professeur")
  disponibilites Disponibilite[]
}

model Role {
  id          Int     @id @default(autoincrement())
  nom         String  @unique
  description String?

  users User[]

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("Role")
}

model Cours {
  id           Int     @id @default(autoincrement())
  nom          String
  code         String  @unique
  duree        Int
  etape        Int
  est_harchive Boolean @default(false)

  specialiteId Int?
  specialite   Specialite? @relation(fields: [specialiteId], references: [id])

  typeDeSalleId Int?         @map("type_de_salle_id")
  typeDeSalle   TypeDeSalle? @relation(fields: [typeDeSalleId], references: [id])

  seances          Seance[]
  cours_programmes Cours_Programme[]

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("Cours")
}

model Programme {
  id          Int     @id @default(autoincrement())
  nom         String  @unique
  description String?

  cours_programmes Cours_Programme[]

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("Programme")
}

model Salle {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  capacite    Int
  nom         String
  description String?

  typeDeSalleId Int         @map("type_de_salle_id")
  typeDeSalle   TypeDeSalle @relation(fields: [typeDeSalleId], references: [id])

  seances Seance[]

  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("Salle")
}

model TypeDeSalle {
  id          Int     @id @default(autoincrement())
  nom         String  @unique
  description String?

  salles Salle[]
  cours  Cours[]

  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("TypeDeSalle")
}

model Specialite {
  id  Int    @id @default(autoincrement())
  nom String @unique

  cours Cours[]

  specialite_professeurs Specialite_Professeur[]

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("Specialite")
}

model Disponibilite {
  id   Int    @id @default(autoincrement())
  jour String

  professeurId Int
  professeur Professeur @relation(fields: [professeurId], references: [id])

  // disponibilite_professeurs Disponibilite_Professeur[]

  plageHoraire_Disponibilites PlageHoraire_Disponibilite[]

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("Disponibilite")
  @@unique([professeurId, jour]) // un jour unique par prof
}

model Seance {
  id   Int      @id @default(autoincrement())
  date DateTime

  coursId Int   @map("cours_id")
  cours   Cours @relation(fields: [coursId], references: [id])

  salleId Int   @map("salle_id")
  salle   Salle @relation(fields: [salleId], references: [id])

  professeurId Int?        @map("professeur_id")
  professeur   Professeur? @relation(fields: [professeurId], references: [id])

  plageHoraireId Int          @map("plage_horaire_id")
  plageHoraire   PlageHoraire @relation(fields: [plageHoraireId], references: [id])

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@map("Seance")
  @@unique([professeurId, date, plageHoraireId])
  @@unique([date, plageHoraireId, salleId])
}

model PlageHoraire {
  id          Int      @id @default(autoincrement())
  heure_debut Int      // 8-22 (heure du jour)
  heure_fin   Int      // 9-23 (heure du jour)
  statut      Boolean  @default(false)

  seances Seance[]

  plageHoraire_Disponibilites PlageHoraire_Disponibilite[]

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@unique([heure_debut, heure_fin]) // pas de doublon
  @@map("PlageHoraire")
  
}

model Cours_Programme {
  id Int @id @default(autoincrement())

  coursId Int   @map("cours_id")
  cours   Cours @relation(fields: [coursId], references: [id])

  programmeId Int       @map("programme_id")
  programme   Programme @relation(fields: [programmeId], references: [id])

  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@unique([coursId, programmeId])
  @@map("Cours_Programme")
}

model Specialite_Professeur {
  id Int @id @default(autoincrement())

  specialiteId Int        @map("specialite_id")
  specialite   Specialite @relation(fields: [specialiteId], references: [id])

  professeurId Int        @map("professeur_id")
  professeur   Professeur @relation(fields: [professeurId], references: [id])

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@unique([professeurId, specialiteId])
  @@map("Specialite_Professeur")
}

