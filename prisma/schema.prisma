// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  nom          String
  prenom       String
  email        String @unique
  mot_de_passe String // Note: In a production application, consider hashing passwords for security.

  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id])

  @@map("User")
}

model Professeur {
  id        Int    @id @default(autoincrement())
  nom       String
  prenom    String
  matricule String

  seances Seance[]

  specialite_professeurs Specialite_Professeur[]

  disponibilite_professeurs Disponibilite_Professeur[]

  @@map("Professeur")
}

model Role {
  id          Int    @id @default(autoincrement())
  nom         String
  description String

  users User[]

  @@map("Role")
}

model Cours {
  id           Int     @id @default(autoincrement())
  nom          String
  code         String  @unique
  duree        Int
  etape        Int
  est_harchive Boolean @default(false)

  seances          Seance[]
  cours_programmes Cours_Programme[]

  @@map("Cours")
}

model Programme {
  id          Int    @id @default(autoincrement())
  nom         String
  description String

  cours_programmes Cours_Programme[]

  @@map("Programme")
}

model Salle {
  id       Int    @id @default(autoincrement())
  code     String
  capacite Int

  typeDeSalleId Int         @map("type_de_salle_id")
  typeDeSalle   TypeDeSalle @relation(fields: [typeDeSalleId], references: [id])

  seances Seance[]

  @@map("Salle")
}

model TypeDeSalle {
  id          Int    @id @default(autoincrement())
  nom         String
  description String

  salles Salle[]

  @@map("TypeDeSalle")
}

model Specialite {
  id  Int    @id @default(autoincrement())
  nom String

  specialite_professeurs Specialite_Professeur[]

  @@map("Specialite")
}

model Disponibilite {
  id   Int    @id @default(autoincrement())
  jour String

  disponibilite_professeurs Disponibilite_Professeur[]

  plageHoraire_Disponibilites PlageHoraire_Disponibilite[]

  @@map("Disponibilite")
}

model Seance {
  id   Int      @id @default(autoincrement())
  date DateTime

  coursId Int   @map("cours_id")
  cours   Cours @relation(fields: [coursId], references: [id])

  salleId Int   @map("salle_id")
  salle   Salle @relation(fields: [salleId], references: [id])

  professeurId Int        @map("professeur_id")
  professeur   Professeur @relation(fields: [professeurId], references: [id])

  plageHoraireId Int          @map("plage_horaire_id")
  plageHoraire   PlageHoraire @relation(fields: [plageHoraireId], references: [id])

  @@map("Seance")
}

model PlageHoraire {
  id          Int      @id @default(autoincrement())
  heure_debut DateTime
  heure_fin   DateTime
  statut      Boolean  @default(false)

  seances Seance[]

  plageHoraire_Disponibilites PlageHoraire_Disponibilite[]

  @@map("PlageHoraire")
}

model Cours_Programme {
  id Int @id @default(autoincrement())

  coursId Int   @map("cours_id")
  cours   Cours @relation(fields: [coursId], references: [id])

  programmeId Int       @map("programme_id")
  programme   Programme @relation(fields: [programmeId], references: [id])

  @@map("Cours_Programme")
}

model Specialite_Professeur {
  id Int @id @default(autoincrement())

  specialiteId Int        @map("specialite_id")
  specialite   Specialite @relation(fields: [specialiteId], references: [id])

  professeurId Int        @map("professeur_id")
  professeur   Professeur @relation(fields: [professeurId], references: [id])

  @@map("Specialite_Professeur")
}

model Disponibilite_Professeur {
  id Int @id @default(autoincrement())

  disponibiliteId Int           @map("disponibilite_id")
  disponibilite   Disponibilite @relation(fields: [disponibiliteId], references: [id])

  professeurId Int        @map("professeur_id")
  professeur   Professeur @relation(fields: [professeurId], references: [id])

  @@map("Disponibilite_Professeur")
}

model PlageHoraire_Disponibilite {
  id Int @id @default(autoincrement())

  plageHoraireId Int          @map("plage_horaire_id")
  plageHoraire   PlageHoraire @relation(fields: [plageHoraireId], references: [id])

  disponibiliteId Int           @map("disponibilite_id")
  disponibilite   Disponibilite @relation(fields: [disponibiliteId], references: [id])

  @@map("PlageHoraire_Disponibilite")
}
