model PlageHoraire_Disponibilite {
  id Int @id @default(autoincrement())

  plageHoraireId Int          @map("plage_horaire_id")
  plageHoraire   PlageHoraire @relation(fields: [plageHoraireId], references: [id])

  disponibiliteId Int           @map("disponibilite_id")
  disponibilite   Disponibilite @relation(fields: [disponibiliteId], references: [id])

  // Champs de traçabilité
  creerPar    String?
  modifierPar String?
  supprimePar String?
  creerLe     DateTime? @default(now())
  modifierLe  DateTime? @updatedAt
  supprimeLe  DateTime?

  @@unique([plageHoraireId, disponibiliteId])
  @@map("PlageHoraire_Disponibilite")
}
